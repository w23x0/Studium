   "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>\nbody{margin:0;padding:8px;font-family:system-ui,sans-serif;color:var(--studium-fg);background:var(--studium-bg);font-size:13px}\ncanvas{width:100%;height:auto;display:block;border:1px solid var(--studium-border);border-radius:4px}\n.row{display:flex;gap:10px;align-items:center;margin:8px 0;flex-wrap:wrap}\ninput[type=range]{flex:1;min-width:160px}\nbutton{font:inherit;padding:4px 12px;border:1px solid var(--studium-border);border-radius:4px;background:transparent;color:var(--studium-accent);cursor:pointer}\n.mut{color:var(--studium-muted);font-size:12px}\n#rd{line-height:1.7;display:none}\n#cur{display:none}\nb{color:var(--studium-accent);font-weight:600}\n</style></head><body>\n<div class=\"row\"><button id=\"show\">看结果（先猜完再点）</button>\n<span id=\"cur\" style=\"flex:1\"><span style=\"display:flex;gap:8px;align-items:center\">时间 <input id=\"t\" type=\"range\" min=\"0\" max=\"300\" step=\"0.5\" value=\"0\" style=\"flex:1\"></span></span></div>\n<canvas id=\"c\" width=\"680\" height=\"400\"></canvas>\n<div id=\"rd\" style=\"margin-top:6px\"></div>\n<div class=\"mut\" style=\"margin-top:6px\">时间尺度几十到几百 μs，比 2 μs 的开关周期长得多，所以开关节点按平均值 ccr/144×12 算，不画纹波。L=10 μH，C=22 μF，负载 2.5 Ω。t=0 时 ccr 从 60 改成 61，之后不再改，没有循环。</div>\n<script>\nvar L=10e-6,C=22e-6,R=2.5,tgt=61/144*12,dt=0.02e-6;\nvar S=[],v=5,i=2;\nfor(var n=0;n<=Math.round(300e-6/dt);n++){\n if(n%25==0)S.push({t:n*dt*1e6,v:v,i:i});\n i+=(tgt-v)/L*dt; v+=(i-v/R)/C*dt;\n}\nvar shown=false,cv=document.getElementById('c'),g=cv.getContext('2d');\nfunction col(n){return getComputedStyle(document.body).getPropertyValue(n).trim()||'#888'}\nvar X0=52,XW=680-52-14;\nfunction X(t){return X0+(t+20)/320*XW}\nfunction panel(y0,h,lo,hi,step,lab,fmt){\n var bd=col('--studium-border'),mu=col('--studium-muted');\n g.strokeStyle=bd;g.lineWidth=1;g.strokeRect(X0,y0,XW,h);\n g.font='11px sans-serif';g.textAlign='right';\n for(var a=lo;a<=hi+1e-9;a+=step){var y=y0+h-(a-lo)/(hi-lo)*h;\n  g.fillStyle=mu;g.fillText(a.toFixed(fmt),X0-5,y+4);\n  g.globalAlpha=.35;g.strokeStyle=bd;g.beginPath();g.moveTo(X0,y);g.lineTo(X0+XW,y);g.stroke();g.globalAlpha=1}\n g.textAlign='left';g.fillStyle=col('--studium-fg');g.fillText(lab,X0+6,y0+14);\n}\nfunction line(y0,h,lo,hi,fn,color,dash,w){\n g.strokeStyle=color;g.lineWidth=w||2;g.setLineDash(dash||[]);g.beginPath();\n g.moveTo(X(-20),y0+h-(fn(null)-lo)/(hi-lo)*h);\n g.lineTo(X(0),y0+h-(fn(null)-lo)/(hi-lo)*h);\n for(var k=0;k<S.length;k++){g.lineTo(X(S[k].t),y0+h-(fn(S[k])-lo)/(hi-lo)*h)}\n g.stroke();g.setLineDash([]);\n}\nfunction at(t){return S[Math.min(S.length-1,Math.round(t/0.5))]}\nfunction draw(){\n var W=cv.width,H=cv.height,ac=col('--studium-accent'),mu=col('--studium-muted'),fg=col('--studium-fg');\n g.clearRect(0,0,W,H);\n var P1=[8,200,4.95,5.20],P2=[226,140,1.95,2.20];\n panel(P1[0],P1[1],P1[2],P1[3],0.05,'电压 V：虚线 = ccr/144×12，实线 = 输出',2);\n panel(P2[0],P2[1],P2[2],P2[3],0.05,'电流 A：实线 = 电感电流，虚线 = 负载电流（输出/2.5 Ω）',2);\n /* dashed target: step at 0 */\n g.strokeStyle=mu;g.lineWidth=2;g.setLineDash([6,4]);g.beginPath();\n function Y1(a){return P1[0]+P1[1]-(a-P1[2])/(P1[3]-P1[2])*P1[1]}\n g.moveTo(X(-20),Y1(5));g.lineTo(X(0),Y1(5));g.lineTo(X(0),Y1(tgt));g.lineTo(X(300),Y1(tgt));g.stroke();g.setLineDash([]);\n if(shown){\n  line(P1[0],P1[1],P1[2],P1[3],function(s){return s?s.v:5},ac);\n  line(P2[0],P2[1],P2[2],P2[3],function(s){return s?s.i:2},ac);\n  line(P2[0],P2[1],P2[2],P2[3],function(s){return s?s.v/R:2},mu,[6,4]);\n  var t=+document.getElementById('t').value;\n  g.strokeStyle=fg;g.lineWidth=1;g.globalAlpha=.6;g.beginPath();g.moveTo(X(t),P1[0]);g.lineTo(X(t),P2[0]+P2[1]);g.stroke();g.globalAlpha=1;\n  var s=at(t);\n  var du=tgt-s.v,dc=s.i-s.v/R;\n  document.getElementById('rd').innerHTML='t = <b>'+t.toFixed(1)+' μs</b>　虚线 '+tgt.toFixed(3)+' V，输出 <b>'+s.v.toFixed(3)+' V</b>　电感电流 <b>'+s.i.toFixed(3)+' A</b>，负载电流 '+(s.v/R).toFixed(3)+' A<br>'+\n  (du>0?'虚线高于输出 → 电感电流在涨':'虚线低于输出 → 电感电流在跌')+'；'+(dc>0?'电感电流大于负载电流 → 输出在涨':'电感电流小于负载电流 → 输出在跌');\n }else{\n  g.fillStyle=mu;g.font='12px sans-serif';g.textAlign='center';g.fillText('输出和电感电流从 t=0 往后怎么走？先猜',X(150),Y1(5.02));\n }\n g.fillStyle=mu;g.font='11px sans-serif';g.textAlign='center';\n for(var tt=0;tt<=300;tt+=50)g.fillText(tt+' μs',X(tt),390);\n}\ndocument.getElementById('show').onclick=function(){\n shown=true;this.style.display='none';\n document.getElementById('cur').style.display='block';document.getElementById('rd').style.display='block';\n if(window.studium)studium.setState('学习者点开了“只改一档之后”的结果');\n draw();\n};\ndocument.getElementById('t').oninput=function(){\n if(window.studium)studium.setState('学习者把“只改一档之后”的时间游标拖到 '+this.value+' μs');\n draw();\n};\ndraw();\n</script></body></html>"
