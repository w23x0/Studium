{
  "name": "studium",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others --names gateway,web \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:gateway": "dotenv -e .env -e .env.bifrost -- node scripts/bifrost.mjs start",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "concurrently --kill-others --names gateway,web \"npm:gateway:start\" \"npm:start:web\"",
    "start:web": "next start --hostname 127.0.0.1",
    "gateway:install": "node scripts/bifrost.mjs install",
    "gateway:configure": "dotenv -e .env -e .env.bifrost -- node scripts/bifrost.mjs configure",
    "gateway:verify": "node scripts/bifrost.mjs verify",
    "gateway:start": "dotenv -e .env -e .env.bifrost -- node scripts/bifrost.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.3",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
