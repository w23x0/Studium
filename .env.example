# Studium -> local LiteLLM Proxy
LLM_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
LLM_GATEWAY_API_KEY=sk-local-studium-change-me
LLM_MODEL=studium-m1
LLM_TIMEOUT_MS=60000

# LiteLLM Proxy -> the single real M1 model
LITELLM_MASTER_KEY=sk-local-studium-change-me
STUDIUM_UPSTREAM_MODEL=provider/model-name
STUDIUM_UPSTREAM_API_KEY=replace-with-real-provider-key
