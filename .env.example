# Studium -> local Bifrost transport v1.6.3
STUDIUM_LLM_GATEWAY_BASE_URL=http://127.0.0.1:4000/openai/v1
STUDIUM_LLM_GATEWAY_API_KEY=sk-bf-replace-with-random-local-token
STUDIUM_LLM_MODEL=studium-openai/studium-m1
STUDIUM_LLM_TIMEOUT_MS=60000
STUDIUM_LLM_AUDIT_DIR=var/audit/llm-calls

# Provider and Bifrost control-plane secrets belong in .env.bifrost, not here.
