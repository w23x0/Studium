{"src": "apostol:projection-onto-subspace", "rel": "requires", "dst": "apostol:projection-formula", "origin": "source", "evidence": {"file": "15.14.md", "quote": "is called the projection of $x$ on the subspace $S$"}}
{"src": "apostol:projection-along-element", "rel": "part-of", "dst": "apostol:projection-formula", "origin": "source", "evidence": {"file": "15.14.md", "quote": "The element s is the sum of the projections of x along each basis element."}}
{"src": "apostol:orthogonal-decomposition", "rel": "requires", "dst": "apostol:projection-formula", "origin": "source", "evidence": {"file": "15.14.md", "quote": "s = \\sum_ {i = 1} ^ {n} (x, e _ {i}) e _ {i}, \\quad s ^ {\\perp} = x - s."}}
