@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix ex:  <http://example.org/ch15/> .

# Node triples map: wrapped form  { "nodes": [ ... ] }
# Rule set is IDENTICAL to mapping-full.ttl so that T2 measures ONLY the
# difference between the two JSON document shapes (array vs wrapped object).
<http://example.org/ch15/NodeMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "data/wrapped-full.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.nodes[*]"
    ] ;
    rr:subjectMap [ rr:template "http://example.org/ch15/node/{id}" ] ;
    rr:predicateObjectMap [
        rr:predicate ex:name_en ;
        rr:objectMap [ rml:reference "name_en" ; rr:language "en" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:name_zh ;
        rr:objectMap [ rml:reference "name_zh" ; rr:language "zh" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:node_type ;
        rr:objectMap [ rml:reference "node_type" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:statement ;
        rr:objectMap [ rml:reference "statement" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:section ;
        rr:objectMap [ rml:reference "sections[*]" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:alias ;
        rr:objectMap [ rml:reference "aliases[*]" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:hasAnchor ;
        rr:objectMap [ rr:template "http://example.org/ch15/anchor/{id}/{anchors[*].quote}" ]
    ] .

# Anchor triples map: descend into nested anchors array via wrapped path
<http://example.org/ch15/AnchorMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "data/wrapped-full.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.nodes[*].anchors[*]"
    ] ;
    rr:subjectMap [ rr:template "http://example.org/ch15/anchor/{file}#{quote}" ] ;
    rr:predicateObjectMap [
        rr:predicate ex:file ;
        rr:objectMap [ rml:reference "file" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:quote ;
        rr:objectMap [ rml:reference "quote" ]
    ] .
