# P7 shapes — extends P2 with G4 QUDT optional + documents other rel_note as JSONL-side rule
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <urn:studium:> .
@prefix rel: <urn:studium:rel:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

# Inherit P2 NodeShape constraints (copy core)
ex:NodeShape
  a sh:NodeShape ;
  sh:targetClass ex:Node ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path ex:nodeType ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "concept" "theorem" "method" "notation" ) ;
  ] ;
  sh:property [ sh:path rel:is-a ;        sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:part-of ;     sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:requires ;    sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:implies ;     sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:equivalent ;  sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:contrasts ;   sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:applies-to ;  sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:generalizes ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:alias-of ;    sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rel:other ;       sh:nodeKind sh:IRI ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "edgeEvidence must match anchorQuote on node" ;
    sh:select """
      PREFIX ex: <urn:studium:>
      SELECT $this WHERE {
        $this ex:edgeEvidence ?q .
        FILTER NOT EXISTS { $this ex:anchorQuote ?q }
      }
    """ ;
  ] .

# G4 optional: notation nodes with qudt:unit must have qudt:quantityKind (0 nodes expected on current corpus)
ex:NotationQudtShape
  a sh:NodeShape ;
  sh:target [
    sh:and (
      [ sh:class ex:Node ]
      [ sh:property [ sh:path ex:nodeType ; sh:hasValue "notation" ] ]
    )
  ] ;
  sh:property [
    sh:path qudt:unit ;
    sh:minCount 0 ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "qudt:unit present requires qudt:quantityKind" ;
    sh:select """
      PREFIX ex: <urn:studium:>
      PREFIX qudt: <http://qudt.org/schema/qudt/>
      SELECT $this WHERE {
        $this qudt:unit ?u .
        FILTER NOT EXISTS { $this qudt:quantityKind ?k }
      }
    """ ;
  ] .
