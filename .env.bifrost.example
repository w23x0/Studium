# Loaded only by the Bifrost launcher; Next.js does not load this filename.
STUDIUM_UPSTREAM_PROVIDER=openai
STUDIUM_UPSTREAM_MODEL=model-name
STUDIUM_UPSTREAM_API_KEY=replace-with-real-provider-key

# Protect Bifrost's loopback management surface and encrypted config store.
BIFROST_ADMIN_USERNAME=studium
BIFROST_ADMIN_PASSWORD=replace-with-random-admin-password
BIFROST_ENCRYPTION_KEY=replace-with-random-encryption-key
